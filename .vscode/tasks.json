{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev Marker: Mark",
      "type": "shell",
      "command": "node scripts/dev-marker.js mark"
    },
    {
      "label": "Dev Marker: Unmark",
      "type": "shell",
      "command": "node scripts/dev-marker.js unmark"
    },
    {
      "label": "Debug Prepare",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Dev Marker: Mark",
        "TypeScript Compile"
      ]
    },
    {
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "label": "TypeScript Compile",
      "detail": "tsc -p ./"
    },
    {
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "group": "build",
      "label": "TypeScript Watch",
      "detail": "tsc -watch -p ./"
    }
  ]
}